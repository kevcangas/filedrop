# ==============================================================================
# Enlace - Archivo de Ejemplo de Variables de Entorno (.env.example)
# Copia este archivo como ".env" y ajusta los valores segun tus necesidades.
# NUNCA subas tu archivo ".env" a repositorios publicos o Git.
# ==============================================================================

# Contrasena de acceso al servicio.
# Si la dejas vacia (""), Enlace generara una contrasena aleatoria segura al arrancar.
ENLACE_PASSWORD=cambia-esta-clave-secreta

# Puerto interno/local donde escuchara el servidor Enlace.
# Por defecto es 41823.
ENLACE_PORT=41823

# IP real de esta maquina en tu red local WiFi/LAN (ej: 192.168.1.50).
# Si se deja vacia, Enlace intentara detectarla automaticamente.
ENLACE_HOST_IP=

# Clave secreta utilizada por Flask para firmar cookies de sesion.
ENLACE_SECRET_KEY=cambia-esta-clave-secreta-para-cookies

# URL publica si usas un proxy inverso o tunel (ej: https://enlace.midominio.com).
ENLACE_PUBLIC_URL=

# Cada cuantas horas se rota la contrasena aleatoria (solo si no usas una contrasena fija).
# Pon 0 para desactivar la rotacion automatica.
ENLACE_PASSWORD_ROTAR_HORAS=1

# Dias que durara la sesion iniciada en el navegador antes de pedir la contrasena nuevamente.
ENLACE_SESION_DIAS=10

# Horas de expiracion automatica para los archivos depositados en el buzon.
ENLACE_BUZON_HORAS=72

# Desactivar apertura automatica del navegador al iniciar el servidor (1 = Si, 0 = No).
# Recomendado en 1 para servidores sin interfaz grafica o Docker.
ENLACE_NO_BROWSER=0

# ------------------------------------------------------------------------------
# Configuración SMTP (Opcional - Envio de contrasena/notificaciones por correo)
# ------------------------------------------------------------------------------
ENLACE_SMTP_HOST=
ENLACE_SMTP_PORT=587
ENLACE_SMTP_USER=
ENLACE_SMTP_PASS=
ENLACE_SMTP_FROM=
ENLACE_SMTP_TLS=1
